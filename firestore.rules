rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SHARED UTILITIES ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 256
        && data.createdAt == request.time;
    }

    function isValidSource(data) {
      return data.keys().hasAll(['type', 'title', 'content', 'createdAt'])
        && (data.type == 'url' || data.type == 'text' || data.type == 'file')
        && data.title is string && data.title.size() <= 1024
        && data.content is string && data.content.size() <= 800000
        && data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt'])
        && (data.role == 'user' || data.role == 'model')
        && data.content is string && data.content.size() <= 100000
        && data.createdAt == request.time;
    }

    // Project Collection
    match /projects/{projectId} {
      allow create: if isSignedIn() && isValidProject(request.resource.data);
      allow get, delete, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Source Subcollection
      match /sources/{sourceId} {
        allow create: if isSignedIn() 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
          && isValidSource(request.resource.data);
          
        allow list, get, delete: if isSignedIn() 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
      
      // Message Subcollection
      match /messages/{messageId} {
        allow create: if isSignedIn() 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
          && isValidMessage(request.resource.data);
          
        allow list, get: if isSignedIn() 
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }
  }
}
